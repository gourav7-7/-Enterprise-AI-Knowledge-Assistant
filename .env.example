# Copy to .env and fill in your values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)

# --- OpenAI (required) ---
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_RETRIES=3

CHAT_TEMPERATURE=0.3
CHAT_TOP_K=6

EVAL_TEMPERATURE=0.0
EVAL_TOP_K=4

# --- RAG settings ---
EMBEDDING_MODEL="text-embedding-3-small"
CHUNK_SIZE=700
CHUNK_OVERLAP=120
CHROMA_DIR="data/chroma"
COLLECTION_NAME="knowledge_base"
TOP_K=6
LOG_LEVEL="INFO"

# --- Auth (required) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="change-me-32-byte-hex"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database ---
# Local (no Docker): point at SQLite or a local Postgres.
#   SQLite:   leave DATABASE_URL unset to use the default (data/app.db)
#   Postgres: DATABASE_URL="postgresql+psycopg://user:pass@localhost:5432/knowledge_assistant"
DATABASE_URL="postgresql+psycopg://ka_user:change-me@localhost:5432/knowledge_assistant"

# --- Docker Compose (Postgres service) ---
# Read by docker-compose.yml. In Docker, compose overrides DATABASE_URL to use these.
POSTGRES_USER="ka_user"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="knowledge_assistant"